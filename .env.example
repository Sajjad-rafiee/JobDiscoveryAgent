# Chat model provider: "gemini" (default) or "openai". Only the selected
# provider's API key/model are required; the other provider's variables may be
# left blank so you can switch providers later without re-entering them.
MODEL_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

OPENAI_API_KEY=
OPENAI_MODEL=

# Career API client mode: "demo" (default; offline demo data, no network) or
# "http" (CareerOpportunityEngine). The base URL and search path are used only
# in http mode.
CAREER_API_MODE=demo
CAREER_API_BASE_URL=http://localhost:8000
CAREER_API_SEARCH_PATH=/opportunities/search
