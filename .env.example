# Career API client mode: "demo" (default, local demo data, no network) or "http".
CAREER_API_MODE=demo
# Required only when CAREER_API_MODE=http. The real Career backend contract is
# not defined yet, so there are no real values to put here.
CAREER_API_BASE_URL=
CAREER_API_SEARCH_PATH=
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-5.6-luna
