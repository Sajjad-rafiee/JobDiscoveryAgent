# Career API client mode: "demo" (default; offline demo data, no network) or
# "http" (CareerOpportunityEngine). The base URL and search path are used only
# in http mode.
CAREER_API_MODE=demo
CAREER_API_BASE_URL=http://localhost:8000
CAREER_API_SEARCH_PATH=/opportunities/search
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-5.6-luna
